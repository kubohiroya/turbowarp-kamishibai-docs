{
  "name": "@kubohiroya/turbowarp-kamishibai-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation source and GitHub Pages build for TurboWarp-Kamishibai",
  "type": "module",
  "exports": {
    "./site-navigation": "./scripts/site-navigation.mjs",
    "./navigation-contract.json": "./docs/tutorials/navigation-contract.json",
    "./site-shell.css": "./site/site-shell.css"
  },
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "SEE LICENSE IN LICENSES.md",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm docs:dsl4:check && pnpm docs:ecosystem:check && pnpm build:publications && node scripts/verify-build.mjs",
    "build:full": "pnpm docs:dsl4:check && pnpm docs:ecosystem:check && pnpm build:publications:full && node scripts/verify-build.mjs",
    "build:publications": "node scripts/build-docs.mjs",
    "build:publications:full": "node scripts/build-docs.mjs --force",
    "docs:dsl4:check": "node scripts/generate-dsl4-reference.mjs --check",
    "docs:dsl4:generate": "node scripts/generate-dsl4-reference.mjs",
    "docs:dsl4:sync": "node scripts/sync-dsl4-schema.mjs",
    "docs:app:sync": "node scripts/app-release.mjs",
    "docs:ecosystem:check": "node scripts/generate-turbowarp-ecosystem.mjs --check",
    "docs:ecosystem:generate": "node scripts/generate-turbowarp-ecosystem.mjs",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,mjs,cjs,json,yaml,yml}\" \".github/**/*.{yaml,yml}\" \"*.md\" \"docs/{user-guides/user-guide-4.0,dsl-author-guides/dsl-4.0-history,developer-guides/{application-materials-guide,application-materials-guide-4.0,developer-guide,developer-guide-4.0,internal-specification,internal-specification-4.0,extension-guide,extension-guide-4.0,turbowarp-ecosystem,dsl-3.1-diagnostics-design,dsl-4.0-diagnostics-design,dsl4-implementation-walkthrough,dependency-audit,release-smoke,release-smoke-4.0,tm-extension-id-migration,upstream-fork-policy},tutorials/*,LICENSE}.md\" \"site/**/*.{html,css}\"",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm build",
    "preview:document": "vivliostyle preview --config docs/vivliostyle.general.config.mjs",
    "preview:workshop": "vivliostyle preview --config docs/vivliostyle.workshop.config.mjs",
    "preview:staff": "vivliostyle preview --config docs/vivliostyle.staff.config.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vivliostyle/cli": "11.1.0",
    "ajv": "8.18.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "rubygana": "github:kubohiroya/rubygana#649cba1138f73f71f514711716e9a61a858ba712",
    "typescript": "7.0.2",
    "yaml": "2.8.1"
  }
}
